# Local development database (Docker container "oakvale-lms-postgres", port 5436)
DATABASE_URL=

AUTH_SECRET=
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3000"

# Paystack — leave unset to simulate payments locally
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Resend — leave unset to log emails instead of sending
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=oakvale-lms
# Local only: an S3-compatible endpoint (MinIO) instead of Cloudflare
R2_ENDPOINT=

# AI tutor (Vercel AI Gateway). Optional on Vercel, where OIDC is used;
# for local dev run `vercel env pull` or set a Gateway API key here.
AI_GATEWAY_API_KEY=
# Or call OpenAI directly instead of the Gateway (takes priority when set).
OPENAI_API_KEY=

# --- Pre-launch email sequence ---
# Opening day (Lagos time). Emails 2–3 send before it; Email 4 the day before.
LAUNCH_DATE="2026-11-02"
# Protects /api/cron/emails; Vercel Cron sends it automatically. Any long random string.
CRON_SECRET=
# Optional: shown in the launch-eve email when set.
SUPPORT_WHATSAPP=
PLAY_STORE_URL=
APP_STORE_URL=

# Android app download prompt. Full https link to the signed release APK; leave
# empty to hide the prompt. Public (inlined at build), so redeploy after changing.
NEXT_PUBLIC_ANDROID_APK_URL=
