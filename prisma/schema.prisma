// Oakvale LMS - Prisma schema
//
// Catalogue:  Program → Course → Module → Lesson (SCORM | HTML | VIDEO | AUDIO | QUIZ)
// Commerce:   Program → Tier (priced) → TierCourse (which courses a tier unlocks)
//             User buys a Tier → Enrollment (+ Payment via Paystack)
// Learning:   LessonProgress / ScormState / QuizAttempt per user
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ------------------------------------------------------------------ *
 * Accounts
 * ------------------------------------------------------------------
 */

enum Role {
  LEARNER
  ADMIN
}

model User {
  id                String               @id @default(cuid())
  name              String
  email             String               @unique
  // WhatsApp / phone number, stored normalised (e.g. "+2348108189514").
  phone             String?
  passwordHash      String
  role              Role                 @default(LEARNER)
  // Set when the learner clicks the link in their sign-up email (or resets
  // their password by email). Required before paying or opening lessons.
  emailVerifiedAt   DateTime?
  // When the "courses are open" email went out (sent once, after pre-launch).
  launchEmailSentAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  resetTokens       PasswordResetToken[]
  verifyTokens      EmailVerificationToken[]
  enrollments       Enrollment[]
  payments          Payment[]
  progress          LessonProgress[]
  blockProgress     BlockProgress[]
  scormStates       ScormState[]
  quizAttempts      QuizAttempt[]
  tutorThreads      TutorThread[]
  supportChat       SupportConversation?
  supportMessages   SupportMessage[]
  emailDeliveries   EmailDelivery[]
  certificates      Certificate[]
  communityProfile  CommunityProfile?
  posts             Post[]
  comments          Comment[]
  reactions         Reaction[]
  eventRsvps        EventRsvp[]
  eventsCreated     CommunityEvent[]
  notifications     Notification[]       @relation("NotificationRecipient")
  notificationsSent Notification[]       @relation("NotificationActor")
  reports           PostReport[]
}

/// Single-use, time-limited password reset tokens. Only the SHA-256 hash of the
/// token is stored — the raw token exists solely in the emailed link.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One row per attempt at a rate-limited action (see src/lib/rate-limit.ts).
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/**
 * ------------------------------------------------------------------ *
 * Catalogue
 * ------------------------------------------------------------------
 */

model Program {
  id          String   @id @default(cuid())
  // Matches the marketing site's slugs ("adult-care", "child-care") so its
  // tier CTAs (/enroll?track=<slug>&tier=<tier>) resolve here.
  slug        String   @unique
  title       String
  description String   @default("")
  coverImage  String?
  published   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tiers       Tier[]
  courses     Course[]
  groups      CommunityGroup[]

  @@index([published, order])
}

/// A purchasable level of a program (e.g. Foundation / Professional / Full).
model Tier {
  id          String       @id @default(cuid())
  program     Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId   String
  slug        String
  name        String
  description String       @default("")
  price       Int // kobo (NGN * 100), to match Paystack
  order       Int          @default(0)
  published   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  courses     TierCourse[]
  enrollments Enrollment[]
  groups      CommunityGroup[]

  @@unique([programId, slug])
  @@index([programId, order])
}

/// Which courses a tier unlocks.
model TierCourse {
  tier     Tier   @relation(fields: [tierId], references: [id], onDelete: Cascade)
  tierId   String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  @@id([tierId, courseId])
  @@index([courseId])
}

model Course {
  id                    String               @id @default(cuid())
  program               Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId             String
  slug                  String
  title                 String
  description           String               @default("")
  coverImage            String?
  order                 Int                  @default(0)
  published             Boolean              @default(false)
  // When true, each lesson unlocks only after the previous one is completed.
  sequential            Boolean              @default(false)
  // Course that must be completed first (e.g. Professional requires Foundation).
  prerequisite          Course?              @relation("CoursePrerequisite", fields: [prerequisiteId], references: [id], onDelete: SetNull)
  prerequisiteId        String?
  dependents            Course[]             @relation("CoursePrerequisite")
  // Certificate issued once every lesson is done and the quiz average reaches the pass mark.
  certificateEnabled    Boolean              @default(true)
  certificateTemplate   CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)
  certificateTemplateId String?
  certificatePassMark   Int                  @default(70) // percent, average of the course's quizzes
  // CPD certificate, sent to the learner directly by an outside issuing body.
  cpdEnabled            Boolean              @default(false)
  cpdProvider           String               @default("")
  cpdHours              Int?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  modules               Module[]
  tiers                 TierCourse[]
  certificates          Certificate[]

  @@unique([programId, slug])
  @@index([programId, order])
}

model Module {
  id        String   @id @default(cuid())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessons   Lesson[]

  @@index([courseId, order])
}

enum QuizKind {
  QUIZ
  EXAM
}

/// What a lesson mainly is. A lesson with a single part takes that part's type;
/// a lesson with several parts (or none yet) is MIXED.
enum LessonType {
  SCORM
  HTML
  VIDEO
  AUDIO
  QUIZ
  DOCUMENT
  TEXT
  MIXED
}

/// The kinds of part a lesson can be built from.
enum BlockType {
  VIDEO
  AUDIO
  SCORM
  HTML
  DOCUMENT // PDF, Word, PowerPoint, Excel or an image
  TEXT // written content (Markdown) typed in the editor
  QUIZ // marks where the lesson's quiz sits
}

model Lesson {
  id           String           @id @default(cuid())
  module       Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId     String
  title        String
  // Derived from the lesson's parts (see lessonTypeFor); never edited directly.
  type         LessonType
  // Optional notes shown under the player.
  description  String           @default("")
  // Extra material for the AI tutor, e.g. a transcript for video/audio lessons.
  tutorNotes   String           @default("")
  order        Int              @default(0)
  published    Boolean          @default(true)
  // Sum of the parts' durations.
  durationSec  Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  // The lesson's content, in the order learners meet it.
  blocks       LessonBlock[]
  assets       ContentAsset[]
  // At most one quiz per lesson; a QUIZ part says where it appears.
  quiz         Quiz?
  progress     LessonProgress[]
  scormStates  ScormState[]
  tutorThreads TutorThread[]

  @@index([moduleId, order])
}

/// One part of a lesson: a video, a document, some text, a quiz…
/// A lesson holds at most one SCORM part and one QUIZ part, because SCORM
/// state and quiz attempts are kept per lesson.
model LessonBlock {
  id          String          @id @default(cuid())
  lesson      Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String
  type        BlockType
  // Optional heading shown above the part.
  title       String          @default("")
  order       Int             @default(0)
  // Learners must complete required parts for the lesson to count as done.
  required    Boolean         @default(true)
  // TEXT parts: the written content, as Markdown.
  body        String          @default("")
  durationSec Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  asset       ContentAsset?
  progress    BlockProgress[]

  @@index([lessonId, order])
}

enum AssetStatus {
  UPLOADING // presigned URL issued, browser uploading to R2
  PROCESSING // SCORM/HTML zip being unpacked
  READY
  FAILED
}

/// The uploaded file behind a VIDEO / AUDIO / SCORM / HTML / DOCUMENT part, stored in R2.
model ContentAsset {
  id           String      @id @default(cuid())
  block        LessonBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  blockId      String      @unique
  // The block's lesson, kept here so access checks need no join.
  lesson       Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId     String
  // R2 key of the uploaded file. Unpacked SCORM/HTML packages live under
  // "content/<assetId>/" and are served by the same-origin content route.
  storageKey   String
  fileName     String
  mimeType     String
  sizeBytes    Int?
  // Entry file inside an unpacked package, e.g. "index_lms.html".
  launchPath   String?
  scormVersion String? // "1.2" | "2004"
  // Plain text pulled from the package's HTML, used to ground the AI tutor.
  textContent  String?
  // Which text extractor produced textContent; older ones are re-run (see lesson-text.ts).
  textVersion  Int         @default(0)
  status       AssetStatus @default(UPLOADING)
  error        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([lessonId])
}

model Quiz {
  id          String        @id @default(cuid())
  lesson      Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String        @unique
  // QUIZ checks the lessons just before it; EXAM is the final assessment,
  // shown after every other lesson and opened once they're all complete.
  kind        QuizKind      @default(QUIZ)
  passMark    Int           @default(70) // percent
  maxAttempts Int? // null = unlimited
  shuffle     Boolean       @default(false)
  questions   Question[]
  attempts    QuizAttempt[]
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
}

model Question {
  id          String       @id @default(cuid())
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId      String
  order       Int          @default(0)
  type        QuestionType
  prompt      String
  options     Json // [{ id, text }]
  correct     Json // [optionId] — never sent to learners
  explanation String?
  points      Int          @default(1)

  @@index([quizId, order])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  answers   Json // { [questionId]: optionId[] }
  score     Int // percent
  passed    Boolean
  createdAt DateTime @default(now())

  @@index([quizId, userId])
}

/**
 * ------------------------------------------------------------------ *
 * Commerce
 * ------------------------------------------------------------------
 */

enum EnrollmentStatus {
  PENDING // created, awaiting payment
  ACTIVE // paid (or granted by an admin)
  CANCELLED
}

enum EnrollmentSource {
  PAYSTACK
  ADMIN // granted manually
  LEGACY // imported from the learners_portal cohort checkout
}

model Enrollment {
  id                  String           @id @default(cuid())
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  tier                Tier             @relation(fields: [tierId], references: [id], onDelete: Restrict)
  tierId              String
  status              EnrollmentStatus @default(PENDING)
  source              EnrollmentSource @default(PAYSTACK)
  amount              Int // kobo — tier price at the time of purchase
  activatedAt         DateTime?
  enrolledEmailSentAt DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  payments            Payment[]

  // One enrolment per learner per tier. Retrying checkout reuses the row.
  @@unique([userId, tierId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

model Payment {
  id           String        @id @default(cuid())
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  reference    String        @unique // Paystack transaction reference
  amount       Int // kobo
  status       PaymentStatus @default(PENDING)
  channel      String?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([enrollmentId])
  @@index([userId])
  @@index([status])
}

/**
 * ------------------------------------------------------------------ *
 * Learning progress
 * ------------------------------------------------------------------
 */

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

model LessonProgress {
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String
  status      ProgressStatus @default(IN_PROGRESS)
  // Resume point for video/audio, in seconds.
  positionSec Int?
  // Best quiz / SCORM score, percent.
  score       Int?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@id([userId, lessonId])
  @@index([lessonId])
  @@index([userId, updatedAt])
}

/// A learner's progress through one part of a lesson. The lesson is complete
/// once every required part is (see recordProgress).
model BlockProgress {
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  block       LessonBlock    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  blockId     String
  status      ProgressStatus @default(IN_PROGRESS)
  // Resume point for video/audio, in seconds.
  positionSec Int?
  // Best quiz / SCORM score, percent.
  score       Int?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@id([userId, blockId])
  @@index([blockId])
}

/// The SCORM runtime data model (cmi.*) for a learner's attempt, so a package
/// resumes where it left off (suspend_data, location, status, score).
model ScormState {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId  String
  cmi       Json
  updatedAt DateTime @updatedAt

  @@id([userId, lessonId])
}

/**
 * ------------------------------------------------------------------ *
 * AI tutor
 * ------------------------------------------------------------------
 */

enum TutorRole {
  USER
  ASSISTANT
}

/// One tutor conversation per learner per lesson.
model TutorThread {
  id        String         @id @default(cuid())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  TutorMessage[]

  @@unique([userId, lessonId])
}

model TutorMessage {
  id        String      @id @default(cuid())
  thread    TutorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  role      TutorRole
  content   String
  createdAt DateTime    @default(now())

  @@index([threadId, createdAt])
}

/**
 * ------------------------------------------------------------------ *
 * Support chat (learner ↔ Oakvale support team)
 * ------------------------------------------------------------------
 */

enum SupportStatus {
  OPEN
  RESOLVED
}

/// One ongoing support conversation per learner; any admin can reply.
model SupportConversation {
  id                String           @id @default(cuid())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String           @unique
  status            SupportStatus    @default(OPEN)
  lastMessageAt     DateTime         @default(now())
  // Whether the newest message came from support (drives "awaiting reply").
  lastFromSupport   Boolean          @default(false)
  learnerLastReadAt DateTime         @default(now())
  supportLastReadAt DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  messages          SupportMessage[]

  @@index([status, lastMessageAt])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  // Who wrote it; kept even if that admin account is later removed.
  sender         User?               @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderId       String?
  fromSupport    Boolean
  body           String
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

/**
 * ------------------------------------------------------------------ *
 * Automated emails
 * ------------------------------------------------------------------
 */

/// One row per scheduled email a learner has been sent (e.g. "prelaunch-care").
/// The unique key is claimed before sending, so nobody gets an email twice.
model EmailDelivery {
  id     String   @id @default(cuid())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  key    String
  sentAt DateTime @default(now())

  @@unique([userId, key])
  @@index([key, sentAt])
}

/**
 * ------------------------------------------------------------------ *
 * Certificates
 * ------------------------------------------------------------------
 */

enum CertificateLayout {
  CLASSIC // centred, framed border
  MODERN // coloured side band
  MINIMAL // clean, thin top rule
}

enum CertificateFont {
  SERIF
  SANS
}

/// How an issued certificate looks. Courses pick one; the default is used otherwise.
model CertificateTemplate {
  id              String            @id @default(cuid())
  name            String
  isDefault       Boolean           @default(false)
  layout          CertificateLayout @default(CLASSIC)
  font            CertificateFont   @default(SERIF)
  primaryColor    String            @default("#3229a2")
  accentColor     String            @default("#b08d3c")
  backgroundColor String            @default("#ffffff")
  heading         String            @default("Certificate of Completion")
  intro           String            @default("This is to certify that")
  // Placeholders: {name} {course} {programme} {score} {date} {hours}
  body            String            @default("has successfully completed {course}, part of the {programme} programme.")
  footer          String            @default("")
  signatoryName   String            @default("")
  signatoryTitle  String            @default("")
  signatory2Name  String            @default("")
  signatory2Title String            @default("")
  showScore       Boolean           @default(true)
  showQr          Boolean           @default(true)
  showBarcode     Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  courses         Course[]
  certificates    Certificate[]
}

enum CpdStatus {
  NONE // course has no CPD certificate
  PENDING // learner qualified; details not yet sent to the issuing body
  SUBMITTED // details sent; the body emails the learner directly
  ISSUED // the body has issued it
}

/// A certificate earned by a learner. Names and titles are copied at issue so
/// the certificate still verifies if the course is renamed or deleted.
model Certificate {
  id            String               @id @default(cuid())
  // Public ID printed on the certificate and encoded in its QR code and barcode.
  serial        String               @unique
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  course        Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseId      String?
  template      CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId    String?
  recipientName String
  courseTitle   String
  programTitle  String
  score         Int? // quiz average in percent; null when the course has no quizzes
  cpdStatus     CpdStatus            @default(NONE)
  cpdProvider   String?
  cpdHours      Int?
  cpdUpdatedAt  DateTime?
  issuedAt      DateTime             @default(now())
  revokedAt     DateTime?
  revokedReason String?
  emailSentAt   DateTime?

  @@unique([userId, courseId])
  @@index([cpdStatus, issuedAt])
  @@index([issuedAt])
}

/**
 * ------------------------------------------------------------------ *
 * Community
 * ------------------------------------------------------------------
 * Membership isn't stored: a learner belongs to a group while they hold an
 * ACTIVE enrolment that matches its audience (see src/lib/community/access.ts),
 * so paying adds them and a cancelled enrolment removes them.
 */

enum GroupAudience {
  ALL_PAID // every learner with an active enrolment
  PROGRAM // learners enrolled in `program`
  TIER // learners enrolled in `tier`
}

model CommunityGroup {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String           @default("")
  coverImage  String?
  audience    GroupAudience    @default(ALL_PAID)
  program     Program?         @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId   String?
  tier        Tier?            @relation(fields: [tierId], references: [id], onDelete: Cascade)
  tierId      String?
  order       Int              @default(0)
  archived    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  posts       Post[]
  events      CommunityEvent[]

  @@index([archived, order])
}

/// Community-facing profile; the display name is User.name. Created on first save.
model CommunityProfile {
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @id
  avatar       String? // storage key under community/avatars/<userId>/
  headline     String   @default("")
  bio          String   @default("")
  location     String   @default("")
  // Email me when someone comments on my post or replies to my comment.
  notifyEmail  Boolean  @default(true)
  digestOptOut Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model Post {
  id             String         @id @default(cuid())
  group          CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId        String
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId       String
  body           String
  images         String[]       @default([]) // storage keys under community/<groupId>/
  // Admin announcement: every member is notified.
  announcement   Boolean        @default(false)
  pinnedAt       DateTime?
  lockedAt       DateTime? // no new comments
  commentCount   Int            @default(0)
  reactionCount  Int            @default(0)
  lastActivityAt DateTime       @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  comments       Comment[]
  reactions      Reaction[]
  reports        PostReport[]
  notifications  Notification[]

  @@index([groupId, deletedAt, createdAt])
  @@index([deletedAt, createdAt])
  @@index([authorId])
}

model Comment {
  id        String       @id @default(cuid())
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  // One level of replies: a reply's parent is always a top-level comment.
  parent    Comment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?
  replies   Comment[]    @relation("CommentReplies")
  body      String
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  reactions Reaction[]
  reports   PostReport[]

  @@index([postId, createdAt])
}

enum ReactionKind {
  LIKE
  LOVE
  CELEBRATE
  INSIGHTFUL
}

/// One reaction per person per post or comment (changing it replaces the kind).
model Reaction {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  comment   Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String?
  kind      ReactionKind @default(LIKE)
  createdAt DateTime     @default(now())

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([commentId])
}

model CommunityEvent {
  id             String         @id @default(cuid())
  group          CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId        String
  title          String
  description    String         @default("")
  startsAt       DateTime
  endsAt         DateTime?
  // A venue address, or "Online" with a meeting link.
  location       String         @default("")
  meetingUrl     String?
  coverImage     String?
  createdBy      User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById    String?
  reminderSentAt DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  rsvps          EventRsvp[]
  notifications  Notification[]

  @@index([groupId, startsAt])
  @@index([startsAt])
}

enum RsvpStatus {
  GOING
  MAYBE
  NO
}

model EventRsvp {
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  status    RsvpStatus
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@id([eventId, userId])
  @@index([userId])
}

enum NotificationKind {
  COMMENT_ON_POST
  REPLY
  EVENT_NEW
  EVENT_REMINDER
  ANNOUNCEMENT
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  kind      NotificationKind
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  event     CommunityEvent?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model PostReport {
  id         String    @id @default(cuid())
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String?
  comment    Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId  String?
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  reason     String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolvedAt, createdAt])
}
